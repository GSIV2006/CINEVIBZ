{
  "name": "cinevibz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests scripts *.ts *.json *.md docs/*.md .vscode .github",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md docs/*.md .vscode .github",
    "test:live": "node scripts/live-catalogue-regressions.mjs && node scripts/live-engagement-checks.mjs"
  },
  "dependencies": {
    "framer-motion": "14.14.0",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
